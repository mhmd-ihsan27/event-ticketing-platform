# ==============================
# App Configuration
# ==============================
NODE_ENV=development
APP_PORT=3000
APP_NAME="Manajemen Event & Tiket Digital"

# ==============================
# Database (PostgreSQL)
# ==============================
DATABASE_URL="postgresql://postgres:password@localhost:5432/event_tiket_db?schema=public"

# ==============================
# JWT Authentication
# ==============================
JWT_ACCESS_SECRET=your_access_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================
# Multi-Tenant Configuration
# ==============================
TENANT_HEADER=x-tenant-id

# ==============================
# CORS
# ==============================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================
# Rate Limiting
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==============================
# Logging
# ==============================
LOG_LEVEL=debug

# ==============================
# Third Party (Coming Soon)
# ==============================
# PAYMENT_GATEWAY_KEY=
# EMAIL_SERVICE_HOST=
# EMAIL_SERVICE_PORT=
# STORAGE_BUCKET=
