{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-1234567890ef",
    "name": "Auth Register Test Scenarios",
    "description": "Kumpulan Skenario Pengujian Otomatis Postman untuk Endpoint POST /api/v1/auth/register",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Positif - Registrasi Berhasil (201 Created)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate dynamic unique email for testing",
              "const randomId = Math.floor(Math.random() * 100000);",
              "pm.environment.set('test_email', 'user_' + randomId + '@example.com');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response format matches success standard', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.message).to.be.a('string');",
              "    pm.expect(jsonData.data).to.have.property('user');",
              "});",
              "",
              "pm.test('User is created with default ATTENDEE role', function () {",
              "    const user = pm.response.json().data.user;",
              "    pm.expect(user).to.have.property('id');",
              "    pm.expect(user.role).to.eql('ATTENDEE');",
              "    pm.expect(user.isVerified).to.be.false;",
              "    // Save created email for negative duplicate test",
              "    pm.collectionVariables.set('existing_user_email', user.email);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"{{test_email}}\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/v1/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Negatif - Email Sudah Terdaftar (409 Conflict)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test('ErrorMessage confirms email exists', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.message).to.include('Email sudah terdaftar');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Budi Duplicate\",\n  \"email\": \"admin@eventticket.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/v1/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "3. Negatif - Field Wajib Kosong (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('ErrorMessage validates missing fields', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.message).to.include('wajib diisi');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"User Without Password\",\n  \"email\": \"user_nopass@example.com\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/v1/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    },
    {
      "name": "4. Negatif - Password Kurang dari 6 Karakter (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('ErrorMessage validates password length', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData.message).to.include('minimal 6 karakter');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Short Pass User\",\n  \"email\": \"shortpass@example.com\",\n  \"password\": \"123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/v1/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "v1", "auth", "register"]
        }
      }
    }
  ]
}
